generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model SellerEvent {
  id          String   @id @default(uuid())
  title       String
  description String?
  eventDate   DateTime
  type        String   @default("ROUTINE")
  sellerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  seller      Profile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
}

model Transaction {
  id          String   @id @default(uuid())
  type        String
  category    String
  amount      Float
  description String?
  userId      String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model CommodityPrice {
  id         String   @id @default(uuid())
  commodity  String
  pricePerKg Float
  region     String
  recordedAt DateTime @default(now())

  @@index([commodity])
  @@index([commodity, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
}

model Profile {
  id                    String               @id @default(uuid())
  username              String               @unique
  password              String
  email                 String?
  role                  Role                 @default(BUYER)
  fullName              String?
  farmName              String?
  location              String?
  livestockTypes        String[]             @default([])
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  avatarUrl             String?
  contact               String?
  bannerUrl             String?
  subscriptionExpiresAt DateTime?
  subscriptionTier      String               @default("FREE")
  walletBalance         Float                @default(0)
  cartItems             CartItem[]
  ordersAsBuyer         Order[]              @relation("BuyerOrders")
  ordersAsSeller        Order[]              @relation("SellerOrders")
  products              Product[]
  sellerEvents          SellerEvent[]
  subscriptions         SubscriptionRecord[]
  walletTransactions    WalletTransaction[]
}

model WalletTransaction {
  id            String   @id @default(uuid())
  profileId     String
  type          String
  amount        Float
  fee           Float    @default(0)
  netAmount     Float
  description   String
  referenceId   String?
  paymentMethod String?
  status        String   @default("SUCCESS")
  createdAt     DateTime @default(now())
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt(sort: Desc)])
}

model SubscriptionRecord {
  id           String   @id @default(uuid())
  profileId    String
  plan         String   @default("PLUS")
  amount       Float    @default(79000)
  durationDays Int      @default(30)
  createdAt    DateTime @default(now())
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Product {
  id          String      @id @default(uuid())
  sellerId    String
  title       String
  description String?
  price       Float
  stock       Int         @default(0)
  unit        String      @default("kg")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  category    String      @default("Lainnya")
  minOrder    Int         @default(1)
  imageUrls   String[]    @default([])
  deletedAt   DateTime?
  aiAnalysis  String?
  grade       String?
  isSponsored Boolean     @default(false)
  cartItems   CartItem[]
  orderItems  OrderItem[]
  seller      Profile     @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@index([sellerId, deletedAt])
  @@index([deletedAt])
  @@index([deletedAt, createdAt(sort: Desc)])
  @@index([deletedAt, isSponsored(sort: Desc), createdAt(sort: Desc)])
}

model Order {
  id                   String      @id @default(uuid())
  buyerId              String
  sellerId             String
  totalAmount          Float
  status               OrderStatus @default(PENDING)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  paymentMethod        String?
  platformFee          Float       @default(0)
  shippingAddress      String?
  shippingFee          Float       @default(0)
  shippingMethod       String?
  requestedArrivalDate DateTime?
  buyerProtectionFee   Float       @default(0)
  coldChainFee         Float       @default(0)
  insuranceFee         Float       @default(0)
  qcInspectionFee      Float       @default(0)
  sellerNetPayout      Float       @default(0)
  takeRateFee          Float       @default(0)
  buyer                Profile     @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller               Profile     @relation("SellerOrders", fields: [sellerId], references: [id])
  items                OrderItem[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([buyerId, createdAt(sort: Desc)])
  @@index([sellerId, createdAt(sort: Desc)])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  priceAtTime Float
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

model CartItem {
  id        String   @id @default(uuid())
  buyerId   String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  buyer     Profile  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
  @@index([buyerId])
}

model ProcurementRequest {
  id           String   @id @default(uuid())
  buyerName    String
  buyerContact String
  category     String
  quantity     String
  targetPrice  Float?
  location     String
  description  String?
  status       String   @default("OPEN")
  createdAt    DateTime @default(now())
}

enum Role {
  PRODUCER
  BUYER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}
